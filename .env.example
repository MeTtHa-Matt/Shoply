# Base de donnees
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shoply
DB_USER=shoply
DB_PASSWORD=change-me

# Envoi des emails via SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Shoply

# Cookies de session : true uniquement derriere HTTPS
SESSION_SECURE=false

# Retention des donnees en jours
UNVERIFIED_USER_RETENTION_DAYS=7
NOTIFICATION_RETENTION_DAYS=90
DECLINED_REQUEST_RETENTION_DAYS=180

# Fournisseur IA optionnel pour la commande vocale.
# Renseigner Gemini ou Groq, ou les deux. Ne pas committe les vraies cles.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
